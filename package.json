{
  "name": "deck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "pnpm --filter @cardstack/deck-example-hub demo",
    "replay:collaboration": "node scripts/replay-collaboration.mjs",
    "test:collaboration": "node scripts/test-collaboration.mjs",
    "lint": "pnpm run --filter './packages/**' --if-present -r lint",
    "lint:fix": "pnpm run --filter './packages/**' --if-present -r lint:fix",
    "test": "pnpm run --filter './packages/**' --if-present -r test && pnpm test:collaboration"
  },
  "devDependencies": {
    "prettier": "catalog:"
  }
}
