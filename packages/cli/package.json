{
  "name": "@cardstack/deck-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deck protocol CLI: start, seal, publish, depend, propose, endorse, recall, prove",
  "bin": {
    "deck": "./bin/deck.js"
  },
  "scripts": {
    "test": "node tests/index.ts",
    "lint": "pnpm run lint:js && pnpm run lint:types",
    "lint:js": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "@cardstack/deck": "workspace:*",
    "@cardstack/deck-server": "workspace:*",
    "@cardstack/deck-tools": "workspace:*",
    "@cardstack/deck-history": "workspace:*",
    "@cardstack/deck-conformance": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qunit": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "qunit": "catalog:",
    "typescript": "catalog:"
  }
}
