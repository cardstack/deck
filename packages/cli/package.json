{
  "name": "@deck/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deck protocol CLI: hash, pack, unpack, verify, publish, tag, serve",
  "bin": {
    "deck": "./bin/deck.js"
  },
  "scripts": {
    "test": "node tests/index.ts",
    "lint": "pnpm run lint:js && pnpm run lint:types",
    "lint:js": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "@deck/core": "workspace:*",
    "@deck/server": "workspace:*",
    "@deck/history": "workspace:*",
    "@deck/conformance": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qunit": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "qunit": "catalog:",
    "typescript": "catalog:"
  }
}
