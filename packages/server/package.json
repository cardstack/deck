{
  "name": "@cardstack/deck-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Deck protocol server: read-only versioned serving from an at-rest store",
  "exports": {
    "./server": "./src/server.ts",
    "./watcher": "./src/watcher.ts",
    "./live-events": "./src/live-events.ts",
    "./depot": "./src/depot.ts",
    "./inject-importmap": "./src/inject-importmap.ts",
    "./rebase-daemon": "./src/rebase-daemon.ts",
    "./compression": "./src/compression.ts",
    "./preload": "./src/preload.ts",
    "./tls": "./src/tls.ts",
    "./activity": "./src/activity.ts"
  },
  "scripts": {
    "test": "node tests/index.ts",
    "lint": "pnpm run lint:js && pnpm run lint:types",
    "lint:js": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "@cardstack/deck": "workspace:*",
    "@cardstack/deck-history": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qunit": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "qunit": "catalog:",
    "typescript": "catalog:"
  }
}
